      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "-",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "sum(rate(vllm:request_success_total{service=\"$endpoint\"}[1m]))",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "stat",
      "title": "$ / 1M out tokens @ peak",
      "description": "Node $/hr divided by the peak sustained (1-minute) output tokens per hour in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "-",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "$usd_hr * 1e6 / (3600 * max_over_time((sum(rate(vllm:generation_tokens_total{service=\"$endpoint\"}[1m])))[$__range:15s]))",
          "refId": "A"
        }
      ],
      "id": 9
    },
    {
