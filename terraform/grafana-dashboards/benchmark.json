    {
      "type": "timeseries",
      "title": "Running vs waiting",
      "description": "Running hits its cap (replicas x max_num_seqs), then requests queue: that's saturation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
