{
  "title": "Benchmark",
  "uid": "benchmark",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "tags": [
    "benchmark",
    "vllm",
    "inference"
  ],
  "description": "One endpoint (Trainium or GPU) while the benchmark runs. Pick the endpoint at the top; its $/hr comes from the values file (deviceHourlyUsd x resources.devices).",
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "label": "Endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-1s"
        },
        "refresh": 2,
        "current": {},
        "multi": false,
        "includeAll": false,
        "query": {
          "query": "label_values(vllm:num_requests_running, service)",
          "refId": "endpoint"
        },
        "definition": "label_values(vllm:num_requests_running, service)"
      },
      {
        "name": "usd_hr",
        "label": "Pod $/hr",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-1s"
        },
        "query": {
          "query": "label_values(vllm:num_requests_running{service=\"$endpoint\"}, usd_per_hour)",
          "refId": "usd_hr"
        },
        "definition": "label_values(vllm:num_requests_running{service=\"$endpoint\"}, usd_per_hour)",
        "refresh": 2,
        "current": {},
        "description": "The endpoint's pod $/hr: deviceHourlyUsd x resources.devices from its vllm-serving values file (pod label usd-per-hour). Empty if the values file sets no deviceHourlyUsd."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "TTFT p50",
      "description": "Time to first token (queueing + prefill), median over the last minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "-"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "(histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{service=\"$endpoint\"}[$__rate_interval]))) and on () (sum(rate(vllm:time_to_first_token_seconds_count{service=\"$endpoint\"}[$__rate_interval])) > 0)) or (histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{service=\"$endpoint\"}[1m]))) and on () (sum(rate(vllm:time_to_first_token_seconds_count{service=\"$endpoint\"}[1m])) > 0))",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "ITL p50",
      "description": "Inter-token latency (decode step time), median over the last minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 3,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "-"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "(histogram_quantile(0.5, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket{service=\"$endpoint\"}[$__rate_interval]))) and on () (sum(rate(vllm:inter_token_latency_seconds_count{service=\"$endpoint\"}[$__rate_interval])) > 0)) or (histogram_quantile(0.5, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket{service=\"$endpoint\"}[1m]))) and on () (sum(rate(vllm:inter_token_latency_seconds_count{service=\"$endpoint\"}[1m])) > 0))",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Output tok/s",
      "description": "Generated tokens per second, all replicas, 1-minute rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "-",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "sum(rate(vllm:generation_tokens_total{service=\"$endpoint\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Total tok/s",
      "description": "Prompt + generated tokens per second, all replicas, 1-minute rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "-",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "sum(rate(vllm:generation_tokens_total{service=\"$endpoint\"}[$__rate_interval])) + sum(rate(vllm:prompt_tokens_total{service=\"$endpoint\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "stat",
      "title": "Running",
      "description": "Requests being decoded now (cap = replicas x max_num_seqs).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "-",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "sum(vllm:num_requests_running{service=\"$endpoint\"})",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "stat",
      "title": "Waiting",
      "description": "Requests queued because every replica is at max_num_seqs. Above 0 and growing = past saturation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "-",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "sum(vllm:num_requests_waiting{service=\"$endpoint\"})",
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "type": "stat",
      "title": "Req/s",
      "description": "Completed requests per second, 1-minute rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "-",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "sum(rate(vllm:request_success_total{service=\"$endpoint\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "stat",
      "title": "$ / 1M out tokens @ peak",
      "description": "Pod $/hr x the pods behind the Service (replicas), divided by the peak sustained output tokens per hour in the selected time range. No data if the endpoint's values file sets no deviceHourlyUsd.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "-",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "(vector(0$usd_hr) > 0) * max_over_time(count(count by (pod) (vllm:num_requests_running{service=\"$endpoint\"}))[$__range:15s]) * 1e6 / (3600 * max_over_time((sum(rate(vllm:generation_tokens_total{service=\"$endpoint\"}[5s])))[$__range:1s]))",
          "refId": "A"
        }
      ],
      "id": 9
    },
    {
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
