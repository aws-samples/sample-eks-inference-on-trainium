      "description": "Cost at peak sustained throughput, the live preview of the bench Job summary's $ per 1M output tokens: pod $/hr x the pods behind the Service (replicas), divided by the peak sustained output tokens per hour in the selected time range. No data if the endpoint's values file sets no deviceHourlyUsd.",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "noValue": "-",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "(vector(0$gpu_usd_hr) > 0) * max_over_time(count(count by (pod) (vllm:num_requests_running{service=\"$gpu\"}))[$__range:15s]) * 1e6 / (3600 * max_over_time((sum(rate(vllm:generation_tokens_total{service=\"$gpu\"}[5s])))[$__range:1s]))",
          "refId": "A",
          "instant": false
        }
      ]
    },
