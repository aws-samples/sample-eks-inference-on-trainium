          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "clamp_max(avg by (neuron_device) ((sum by (pod, neuron_device, neuroncore) (avg_over_time(neuroncore_utilization_ratio[$__rate_interval])) * on (pod) group_left (node) max by (pod, node) (kube_pod_info{namespace=\"monitoring\"})) and on (node) max by (node) (kube_pod_info{namespace=\"default\", pod=~\"$endpoint-[a-z0-9]+-[a-z0-9]+\"})), 1) and on (neuron_device) max_over_time((avg by (neuron_device) ((sum by (pod, neuron_device, neuroncore) (avg_over_time(neuroncore_utilization_ratio[$__rate_interval])) * on (pod) group_left (node) max by (pod, node) (kube_pod_info{namespace=\"monitoring\"})) and on (node) max by (node) (kube_pod_info{namespace=\"default\", pod=~\"$endpoint-[a-z0-9]+-[a-z0-9]+\"})))[$__range:15s]) > 0.01",
          "legendFormat": "Trainium2 device {{neuron_device}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "max by (gpu) (avg_over_time(DCGM_FI_DEV_GPU_UTIL[$__rate_interval]) and on (hostname) label_replace(max by (node) (kube_pod_info{namespace=\"default\", pod=~\"$endpoint-[a-z0-9]+-[a-z0-9]+\"}), \"hostname\", \"$1\", \"node\", \"(.*)\")) / 100",
          "legendFormat": "GPU {{gpu}}",
