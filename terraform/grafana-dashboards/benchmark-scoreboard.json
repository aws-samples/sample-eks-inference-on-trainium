{
  "title": "Benchmark scoreboard",
  "uid": "benchmark-scoreboard",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "benchmark",
    "vllm",
    "inference"
  ],
  "description": "Trainium vs GPU side by side while the benchmark runs. Each side's $/hr comes from its values file (deviceHourlyUsd x resources.devices).",
  "templating": {
    "list": [
      {
        "name": "trn2",
        "label": "Trainium endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-1s"
        },
        "query": {
          "query": "label_values(vllm:num_requests_running, service)",
          "refId": "trn2"
        },
        "definition": "label_values(vllm:num_requests_running, service)",
        "refresh": 2,
        "current": {},
        "regex": "/^.*(?:trn|inf|neuron).*$/"
      },
      {
        "name": "trn2_usd_hr",
        "label": "Trainium $/hr (pod)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-1s"
        },
        "query": {
          "query": "label_values(vllm:num_requests_running{service=\"$trn2\"}, usd_per_hour)",
          "refId": "trn2_usd_hr"
        },
        "definition": "label_values(vllm:num_requests_running{service=\"$trn2\"}, usd_per_hour)",
        "refresh": 2,
        "current": {},
        "description": "The Trainium endpoint's pod $/hr: deviceHourlyUsd x resources.devices from its vllm-serving values file (pod label usd-per-hour). Empty if the values file sets no deviceHourlyUsd."
      },
      {
        "name": "gpu",
        "label": "GPU endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-1s"
        },
        "query": {
          "query": "label_values(vllm:num_requests_running, service)",
          "refId": "gpu"
        },
        "definition": "label_values(vllm:num_requests_running, service)",
        "refresh": 2,
        "current": {},
        "regex": "/^(?!.*(?:trn|inf|neuron)).*$/"
      },
      {
        "name": "gpu_usd_hr",
        "label": "GPU $/hr (pod)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-1s"
        },
        "query": {
          "query": "label_values(vllm:num_requests_running{service=\"$gpu\"}, usd_per_hour)",
          "refId": "gpu_usd_hr"
        },
        "definition": "label_values(vllm:num_requests_running{service=\"$gpu\"}, usd_per_hour)",
        "refresh": 2,
        "current": {},
        "description": "The GPU endpoint's pod $/hr: deviceHourlyUsd x resources.devices from its vllm-serving values file (pod label usd-per-hour). Empty if the values file sets no deviceHourlyUsd."
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "id": 1,
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "## AWS Trainium2\n`$trn2` · **$${trn2_usd_hr}/hr** per pod"
      }
    },
    {
      "type": "text",
      "id": 11,
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "## NVIDIA GPU\n`$gpu` · **$${gpu_usd_hr}/hr** per pod"
      }
    },
    {
      "type": "stat",
      "title": "TTFT p50",
      "description": "Time to first token, median over the last minute (server-side).",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 4,
        "w": 2,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "noValue": "-"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "(histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{service=\"$trn2\"}[$__rate_interval]))) and on () (sum(rate(vllm:time_to_first_token_seconds_count{service=\"$trn2\"}[$__rate_interval])) > 0)) or (histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{service=\"$trn2\"}[1m]))) and on () (sum(rate(vllm:time_to_first_token_seconds_count{service=\"$trn2\"}[1m])) > 0))",
          "refId": "A",
          "instant": false
        }
      ]
    },
