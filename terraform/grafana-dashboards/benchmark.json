      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket{service=\"$endpoint\"}[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
