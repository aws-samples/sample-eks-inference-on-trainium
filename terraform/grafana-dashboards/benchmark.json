    {
      "type": "timeseries",
      "title": "Requests / s",
      "description": "completed: requests finished per second (vllm:request_success_total, all finish reasons). arriving (est.): completed + growth of running + waiting, i.e. the request rate reaching the engine, whether or not it keeps up. The gap between the two lines is the backlog building.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
