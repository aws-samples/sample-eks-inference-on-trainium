          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "sum(rate(vllm:generation_tokens_total{service=\"$endpoint\"}[1m])) + sum(rate(vllm:prompt_tokens_total{service=\"$endpoint\"}[1m]))",
          "legendFormat": "total (prompt + output)",
          "refId": "B"
        }
      ],
