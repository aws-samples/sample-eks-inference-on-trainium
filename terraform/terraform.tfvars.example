# Copy to terraform.tfvars, edit, then: terraform -chdir=terraform apply
#   cp terraform/terraform.tfvars.example terraform/terraform.tfvars
# (terraform.tfvars is gitignored so your values never get committed.)
# Uncommented values are required; commented ones show their defaults (variables.tf).

# name = "demo-neuron-eks"

# AWS region - where your Capacity Block is (README: Section 1, step 1).
region = "us-east-2"

# ML Capacity Blocks (README: Section 1, step 2), keyed by the static NodePool to create for
# each: neuron-$TRN, the node pool the vllm-serving values file for $TRN uses.
# Fill in from: scripts/list-reserved-capacity-blocks.py
capacity_blocks_nodepools = {
  "neuron-trn2-3xl" = {
    reservation_id = "cr-..."
    instance_type  = "trn2.3xlarge"
    az             = "us-east-2b"
    node_count     = 1
    hardware       = "neuron"
  }
  # 16 Trainium2 devices (vllm-serving/values-trn2-48xl.yaml):
  # "neuron-trn2-48xl" = {
  #   reservation_id = "cr-..."
  #   instance_type  = "trn2.48xlarge"
  #   az             = "..."
  #   node_count     = 1
  #   hardware       = "neuron"
  # }
}

# Reuse an existing model-cache bucket (same region and account), e.g. one from an earlier
# cluster, so its weights and benchmark results are reused. Terraform never modifies or deletes it.
# Empty or unset: create a new bucket.
# existing_cache_bucket = "neuron-eks-demo"

# Models to stage in S3: name -> HuggingFace checkpoint. The name is the
# model's folder: s3://<bucket>/<name>/ and /tmp/models/<name>/ on nodes.
# models = {
#   "gpt-oss-20b" = "openai/gpt-oss-20b"
# }

# name               = "demo-neuron-eks"   # EKS cluster name / resource prefix
# kubernetes_version = "1.36"
# x86_ami_name    = "amazon-eks-node-al2023-x86_64-standard-1.36-v20260903"
# neuron_ami_name = "amazon-eks-node-al2023-x86_64-neuron-1.36-v20260903"
# gpu_ami_name    = "amazon-eks-node-al2023-x86_64-nvidia-1.36-v20260903"
