    },
    {
      "type": "timeseries",
      "title": "Running vs waiting",
      "description": "Running hits its cap (replicas x max_num_seqs), then requests queue: that's saturation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "sum(vllm:num_requests_running{service=\"$endpoint\"})",
          "legendFormat": "running",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "sum(vllm:num_requests_waiting{service=\"$endpoint\"})",
          "legendFormat": "waiting",
          "refId": "B"
        }
      ],
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Requests / s",
      "description": "completed: requests finished per second (vllm:request_success_total, all finish reasons). arriving (est.): completed + growth of running + waiting, i.e. the request rate reaching the engine, whether or not it keeps up. The gap between the two lines is the backlog building.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "arriving \\(est\\.\\)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "sum(rate(vllm:request_success_total{service=\"$endpoint\"}[1m]))",
          "legendFormat": "completed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "clamp_min(sum (rate(vllm:request_success_total{service=\"$endpoint\"}[1m])) + deriv((sum (vllm:num_requests_running{service=\"$endpoint\"}) + sum (vllm:num_requests_waiting{service=\"$endpoint\"}))[1m:5s]), 0)",
          "legendFormat": "arriving (est.)",
          "refId": "B"
        }
      ],
      "id": 17
    },
    {
      "type": "row",
      "title": "Why: engine and hardware",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": [],
      "id": 18
    },
    {
      "type": "timeseries",
      "title": "Accelerator utilization",
      "description": "Busy time of each accelerator on the node hosting the selected endpoint, one line per device. Both queries are filtered to that node, so only the matching one draws: Trainium2 devices (neuron-monitor: NeuronCores summed across Neuron runtimes, averaged per device; only the devices busy at some point in the selected time range, so a one-device replica on a 16-device trn2.48xlarge draws one line) or GPUs (DCGM).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-1s"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
          "expr": "clamp_max(avg by (neuron_device) ((sum by (pod, neuron_device, neuroncore) (neuroncore_utilization_ratio) * on (pod) group_left (node) max by (pod, node) (kube_pod_info{namespace=\"monitoring\"})) and on (node) max by (node) (kube_pod_info{namespace=\"default\", pod=~\"$endpoint-[a-z0-9]+-[a-z0-9]+\"})), 1) and on (neuron_device) max_over_time((avg by (neuron_device) ((sum by (pod, neuron_device, neuroncore) (neuroncore_utilization_ratio) * on (pod) group_left (node) max by (pod, node) (kube_pod_info{namespace=\"monitoring\"})) and on (node) max by (node) (kube_pod_info{namespace=\"default\", pod=~\"$endpoint-[a-z0-9]+-[a-z0-9]+\"})))[$__range:15s]) > 0.01",
          "legendFormat": "Trainium2 device {{neuron_device}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-1s"
          },
