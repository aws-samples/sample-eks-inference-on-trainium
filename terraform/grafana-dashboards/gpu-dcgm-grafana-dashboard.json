{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Why an NVIDIA GPU endpoint performs as it does: is the GPU the bottleneck, is it held back, what does a token cost.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SM active",
      "description": "Share of cycles the SMs have work (DCGM_FI_PROF_SM_ACTIVE). The real 'how busy is the GPU': GPU utilization only says a kernel is running.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(DCGM_FI_PROF_SM_ACTIVE{hostname=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{modelName}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tensor cores active",
      "description": "Share of cycles the tensor pipe runs (matrix math). Low with high memory bandwidth = memory-bound (small-batch decode); rising with batch size = compute is being used.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(DCGM_FI_PROF_PIPE_TENSOR_ACTIVE{hostname=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{modelName}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Memory bandwidth active",
      "description": "Share of cycles the HBM/GDDR interface moves data (DCGM_FI_PROF_DRAM_ACTIVE).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(DCGM_FI_PROF_DRAM_ACTIVE{hostname=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{modelName}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Power vs limit",
      "description": "Power draw / enforced power limit. Near 100% the GPU lowers clocks to stay in budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "red",
                "value": 0.97
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(DCGM_FI_DEV_POWER_USAGE{hostname=~\"$node\"}[$__rate_interval]) / avg_over_time(DCGM_FI_DEV_ENFORCED_POWER_LIMIT{hostname=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{modelName}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "SM clock vs max",
      "description": "Current SM clock / maximum SM clock. Below ~90% under load = throttled (see Throttled time).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(DCGM_FI_DEV_SM_CLOCK{hostname=~\"$node\"}[$__rate_interval]) / avg_over_time(DCGM_FI_DEV_MAX_SM_CLOCK{hostname=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{modelName}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Last XID error",
      "description": "Last XID error the driver reported (none = no error since the exporter started). Any other value is a GPU or driver fault: check the node.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "none",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time(DCGM_FI_DEV_XID_ERRORS{hostname=~\"$node\"}[$__range])",
          "legendFormat": "{{modelName}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Busy vs. doing work",
      "description": "GPU utilization (dashed) = a kernel is running. SM active = SMs have work; SM occupancy = how full they are. Utilization below 100% under load = the GPU waits on the host (scheduling, sampling, detokenizing). Utilization ~100% with low SM active = many tiny kernels (e.g. batch-1 decode): the GPU looks busy but is mostly idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "maxDataPoints": 100,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "GPU utilization.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(DCGM_FI_DEV_GPU_UTIL{hostname=~\"$node\"}[$__rate_interval]) / 100",
          "legendFormat": "GPU utilization - {{modelName}} {{hostname}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(DCGM_FI_PROF_SM_ACTIVE{hostname=~\"$node\"}[$__rate_interval])",
          "legendFormat": "SM active - {{modelName}} {{hostname}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(DCGM_FI_PROF_SM_OCCUPANCY{hostname=~\"$node\"}[$__rate_interval])",
          "legendFormat": "SM occupancy - {{modelName}} {{hostname}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Compute- or memory-bound?",
      "description": "Tensor pipe vs memory bandwidth. Memory bandwidth high with tensor low = memory-bound (reading weights/KV per token: larger batches help). Tensor rising toward its plateau = compute-bound (larger batches only add latency).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "maxDataPoints": 100,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Memory bandwidth.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(DCGM_FI_PROF_PIPE_TENSOR_ACTIVE{hostname=~\"$node\"}[$__rate_interval])",
          "legendFormat": "Tensor - {{modelName}} {{hostname}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(DCGM_FI_PROF_DRAM_ACTIVE{hostname=~\"$node\"}[$__rate_interval])",
          "legendFormat": "Memory bandwidth - {{modelName}} {{hostname}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Power and clocks",
      "description": "Power as a share of the enforced limit, and SM clock as a share of its maximum. Power pinned at the limit while the clock drops = power-throttled.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "maxDataPoints": 100,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1.05
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "SM clock.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(DCGM_FI_DEV_POWER_USAGE{hostname=~\"$node\"}[$__rate_interval]) / avg_over_time(DCGM_FI_DEV_ENFORCED_POWER_LIMIT{hostname=~\"$node\"}[$__rate_interval])",
          "legendFormat": "Power / limit - {{modelName}} {{hostname}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(DCGM_FI_DEV_SM_CLOCK{hostname=~\"$node\"}[$__rate_interval]) / avg_over_time(DCGM_FI_DEV_MAX_SM_CLOCK{hostname=~\"$node\"}[$__rate_interval])",
          "legendFormat": "SM clock / max - {{modelName}} {{hostname}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Throttled time",
      "description": "Share of time the clocks were held down by the power limit or by temperature (DCGM violation counters). Non-zero during a benchmark = the GPU ran slower than it can.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "maxDataPoints": 100,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(DCGM_FI_DEV_POWER_VIOLATION{hostname=~\"$node\"}[$__rate_interval]) / 1e9",
          "legendFormat": "Power - {{modelName}} {{hostname}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(DCGM_FI_DEV_THERMAL_VIOLATION{hostname=~\"$node\"}[$__rate_interval]) / 1e9",
          "legendFormat": "Thermal - {{modelName}} {{hostname}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Energy per 1K output tokens",
      "description": "GPU power / output tokens per second of the endpoint's pods on that node, x1000: joules per 1,000 generated tokens. Falls as batching improves; the GPU-side view of $ per token.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "maxDataPoints": 100,
      "fieldConfig": {
        "defaults": {
          "unit": "J",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1000 * sum by (hostname, modelName) (avg_over_time(DCGM_FI_DEV_POWER_USAGE{hostname=~\"$node\"}[$__rate_interval])) / on (hostname) group_left () (label_replace(sum by (node) (rate(vllm:generation_tokens_total{service=~\"$endpoint\"}[$__rate_interval]) * on (namespace, pod) group_left (node) max by (namespace, pod, node) (kube_pod_info)), \"hostname\", \"$1\", \"node\", \"(.*)\") > 0)",
          "legendFormat": "{{modelName}} {{hostname}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Load: running requests and KV cache",
      "description": "What each node's GPU is serving: requests in the batch (left) and KV cache usage (right, dashed) of the endpoint's pods on it. Read the panels above against it. KV cache near 100% = memory caps the batch (requests wait or get preempted); GPU memory itself stays flat because vLLM reserves it at startup.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "maxDataPoints": 100,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "KV cache usage.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (node) (avg_over_time(vllm:num_requests_running{service=~\"$endpoint\"}[$__rate_interval]) * on (namespace, pod) group_left (node) max by (namespace, pod, node) (kube_pod_info{node=~\"$node\"}))",
          "legendFormat": "Running requests - {{node}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (node) (avg_over_time(vllm:kv_cache_usage_perc{service=~\"$endpoint\"}[$__rate_interval]) * on (namespace, pod) group_left (node) max by (namespace, pod, node) (kube_pod_info{node=~\"$node\"}))",
          "legendFormat": "KV cache usage - {{node}}",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "gpu",
    "dcgm",
    "nvidia"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
